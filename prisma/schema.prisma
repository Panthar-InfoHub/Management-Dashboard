// ── Panthar Teams — Prisma Schema ──
// Single-org team operations platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  TESTING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}




// ─────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────

model SystemRole {
  name        String   @id // e.g. "ADMIN", "MANAGER", "EMPLOYEE", "INTERN"
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Central entity. Every person in the org is an Employee.
/// Clerk provides identity (clerkId), our DB provides role/authorization.
model Employee {
  id          String         @id @default(cuid())
  clerkId     String         @unique // Clerk user_xxx ID — set via webhook
  email       String         @unique
  firstName   String
  lastName    String
  avatarUrl   String?
  role        String         @default("EMPLOYEE")
  status      EmployeeStatus @default(ACTIVE)
  designation String?        // e.g. "Senior Frontend Engineer"
  phone       String?
  joinDate    DateTime       @default(now())
  
  // ── Employee Codes ──
  pantharCode String?        @unique
  kavachXCode String?        @unique

  // ── Team relation ──
  teamId      String?
  team        Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  leadOfTeams Team[]         @relation("TeamLead")

  // ── Task relations ──
  assignedTasks Task[] @relation("TaskAssignees")
  createdTasks  Task[] @relation("TaskCreator")

  // ── Project relations ──
  projectLead   Project[]       @relation("ProjectLead")
  projectMember ProjectMember[]

  // ── Notification relations ──
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([teamId])
  @@index([role])
  @@index([status])
}

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String? // hex for UI badges
  icon        String?

  leadId  String
  lead    Employee @relation("TeamLead", fields: [leadId], references: [id])
  members Employee[] @relation("TeamMembers")

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  progress    Int           @default(0) // 0–100

  startDate DateTime?
  endDate   DateTime?

  teamId String
  team   Team     @relation(fields: [teamId], references: [id])
  leadId String
  lead   Employee @relation("ProjectLead", fields: [leadId], references: [id])

  tasks   Task[]
  members ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([leadId])
  @@index([status])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  joinedAt   DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(BACKLOG)
  priority       TaskPriority @default(MEDIUM)
  storyPoints    Int?
  labels         String[]     // e.g. ["backend", "security"]

  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  completionNote String?      // required to move to DONE
  prLink         String?      // required to move to DONE
  blockers       String?

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees  Employee[] @relation("TaskAssignees")
  
  // Subtask hierarchy
  parentId   String?
  parent     Task?     @relation("TaskSubtask", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]    @relation("TaskSubtask")

  // Blocker chain
  blockedById String?
  blockedBy   Task?     @relation("TaskBlocker", fields: [blockedById], references: [id])
  blocking    Task[]    @relation("TaskBlocker")

  creatorId  String
  creator    Employee  @relation("TaskCreator", fields: [creatorId], references: [id])

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status, projectId])  // project board filtering
  @@index([parentId])
}

model Comment {
  id       String @id @default(cuid())
  content  String
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// SYSTEM MODELS
// ─────────────────────────────────────────────

model Sequence {
  name  String @id // e.g. "SEQ_PANTHAR", "SEQ_KAVACHX"
  value Int    @default(0)
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String   // "TEAM_ADDED", "PROJECT_ADDED", "TASK_ASSIGNED"
  title       String
  message     String
  actionUrl   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  recipient   Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  
  @@index([recipientId])
  @@index([isRead])
}
