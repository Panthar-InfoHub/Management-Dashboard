DATABASE_URL=
DIRECT_URL=

# ── Clerk Auth ──
# Run `npx clerk@latest init` or get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Clerk Routes ──
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Attendance External API ──
ATTENDANCE_API_KEY=

# ── Email (Resend) ──
# Sends email for announcements, task assignment, and leave / WFH requests.
# Off unless both are set. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Panthar Teams <teams@your-verified-domain.com>"
# EMAIL_REPLY_TO=
# Public URL used for links in emails.
APP_URL=https://your-app-domain.com
# Testing: send every email to this address instead. Outside production,
# email is only sent when this is set, so local dev never emails staff.
# EMAIL_REDIRECT_TO=you@example.com
